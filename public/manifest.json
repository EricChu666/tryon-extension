{
    "manifest_version": 3,
    "name": "Try-On MVP",
    "version": "0.0.1",
    "description": "MVP try-on assistant for Amazon apparel pages.",
    "action": {
        "default_title": "Try-On MVP"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://www.amazon.com/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.amazon.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "mediapipe/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}